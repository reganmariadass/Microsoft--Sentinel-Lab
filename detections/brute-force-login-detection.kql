// Detection Name: Brute Force Login Attempts
// Description: Detects multiple failed login attempts from the same source IP against the same user account.
// Data Source: Windows Security Events
// Event ID: 4625 - Failed logon
// MITRE ATT&CK: T1110 - Brute Force
// Severity: Medium

SecurityEvent
| where EventID == 4625
| where Account !contains "$"
| summarize 
    FailedAttempts = count(),
    FirstAttempt = min(TimeGenerated),
    LastAttempt = max(TimeGenerated)
    by Account, IpAddress, Computer
| where FailedAttempts >= 5
| extend AlertName = "Possible Brute Force Login Attempts"
| extend Severity = "Medium"
| extend MITRETechnique = "T1110 - Brute Force"
| order by FailedAttempts desc
